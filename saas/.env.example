# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Storage
OUTPUT_DIR=/tmp/shorts_output

# Celery (optionnel)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Database (optionnel - pour production)
DATABASE_URL=postgresql://shorts:password@localhost:5432/shorts_db

# Stripe (à ajouter pour monétisation)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Auth (à ajouter)
# CLERK_API_KEY=...
# JWT_SECRET=...

# Storage S3 (optionnel - pour production)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_BUCKET_NAME=shorts-videos
# AWS_REGION=us-east-1
